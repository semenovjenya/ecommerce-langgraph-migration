# Explicit masked LangSmith tracing only. Disable the SDK's auto-tracer.
COMMERCE_AGENT_LANGSMITH_TRACING=false
COMMERCE_AGENT_LANGSMITH_STATE_SUMMARY=false
# Owner-approved sanitized business I/O, DEVELOPMENT ONLY. Never disable HIDE flags.
COMMERCE_AGENT_LANGSMITH_DEBUG=false
LANGSMITH_TRACING=false
LANGSMITH_TRACING_V2=false
LANGCHAIN_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_HIDE_METADATA=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=ai-ecom-commerce-agent-development
# Set only when one key can access more than one workspace.
LANGSMITH_WORKSPACE_ID=

# Existing Langfuse observability project. Both providers may be enabled.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
# Only provider model IDs listed here may be exported for cost attribution.
LANGFUSE_MODEL_ALLOWLIST=gpt-4.1-mini

# Dedicated checkpoint database. Local compose credentials are development-only.
COMMERCE_AGENT_ENVIRONMENT=development
COMMERCE_AGENT_POSTGRES_PASSWORD=commerce-agent-local-only
COMMERCE_AGENT_POSTGRES_PORT=55432
COMMERCE_AGENT_DATABASE_URI=postgresql://commerce_agent:commerce-agent-local-only@localhost:55432/commerce_agent?sslmode=disable
COMMERCE_AGENT_DB_POOL_MIN_SIZE=1
COMMERCE_AGENT_DB_POOL_MAX_SIZE=10
# Internal read API only; set the same long random token in the FastAPI BFF secret store.
# Do not expose the internal service on a public network interface.
COMMERCE_AGENT_SERVICE_TOKEN=

# M2 reads from the business backend. Use a separate long random service token,
# also configured in the backend secret store, and its COMMERCE_AGENT_TENANT_ID.
# This token is NOT the BFF -> runtime credential above.
COMMERCE_AGENT_TOOLS_API_URL=http://127.0.0.1:8000
COMMERCE_AGENT_TOOLS_SERVICE_TOKEN=
